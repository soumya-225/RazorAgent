{
  "name": "razoragent-server",
  "version": "1.0.0",
  "description": "RazorAgent Backend - Agentic Commerce & Revenue Growth Platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "npx prisma migrate dev --name init",
