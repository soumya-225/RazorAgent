# Copy to .env and fill values. Do NOT commit .env
# Database: provide a PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/razoragent_db
PORT=5000
JWT_SECRET=razoragent_super_secret_jwt_key_2026
# Enable internal SBMD fallback (true/false)
SBMD_ENABLED=true
# (Optional) For Razorpay live testing only - do NOT expose RAZORPAY_KEY_SECRET to clients
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=razoragent_webhook_secret_xyz
